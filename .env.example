# ==============================================================================
#  ARENA ESTUDOS ALEPA — exemplo de variáveis de ambiente
#  Copie para .env (raiz), .env.development, .env.staging ou .env.production.
#  NUNCA versione o arquivo com valores reais.
# ==============================================================================

# ---------------------------------------------------------------- AMBIENTE ----
# development | staging | production
NODE_ENV=development
# Porta da API
PORT=4000
# URL pública do frontend (usada em CORS e nos links de e-mail)
APP_WEB_URL=http://localhost:5173
# Prefixo dos endpoints da API
API_PREFIX=/api

# ------------------------------------------------------------------ BANCO ----
# PostgreSQL local (docker compose ou instalação própria):
DATABASE_URL=postgresql://arena:arena_dev@127.0.0.1:5432/arena_estudos?schema=public
# Banco isolado usado pelos testes (nunca aponte para produção)
DATABASE_URL_TEST=postgresql://arena:arena_dev@127.0.0.1:5432/arena_estudos_test?schema=public

# Espera o banco acordar antes de abrir a API (containers, cold start do Supabase).
# Útil no Docker/Render: o backend sobe antes do Postgres e, sem isso, morre na 1ª query.
DB_CONNECT_RETRIES=10
DB_CONNECT_RETRY_DELAY_MS=2000

# --- SUPABASE (descomente e comente as linhas acima) --------------------------
# Abra o projeto em https://supabase.com/dashboard → Project Settings →
# Database → Connection string, e prefira SEMPRE a opção "Session pooler"
# (porta 5432) como DATABASE_URL: uma única URL serve para a API e para as
# migrações, e ela aceita transações interativas.
#
#   DATABASE_URL="postgresql://postgres.<ref>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require"
#   DATABASE_URL_TEST="postgresql://postgres.<ref>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require&schema=arena_test"
#
# Se quiser usar o "Transaction pooler" (porta 6543) na API, acrescente
# `?pgbouncer=true&connection_limit=1` e use a conexão DIRETA (porta 5432)
# apenas na hora de rodar as migrações:
#
#   DATABASE_URL="postgresql://postgres.<ref>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&sslmode=require"
#   DIRECT_URL="postgresql://postgres.<SENHA>@db.<ref>.supabase.com:5432/postgres?sslmode=require"
#
# Dicas importantes:
#  * senha com caracteres especiais (@, #, /) precisa de URL-encode
#    (ex.: "@" vira "%40");
#  * `prisma migrate` NÃO funciona pelo pooler de transação (6543) —
#    use a porta 5432;
#  * para os testes, aponte DATABASE_URL_TEST para OUTRO projeto/ schema,
#    porque a suíte limpa e recria as tabelas.

# --------------------------------------------------------------- SEGURANCA ---
# Segredos: gere com `openssl rand -base64 48`
JWT_ACCESS_SECRET=troque-por-um-segredo-longo-devel
JWT_REFRESH_SECRET=troque-por-outro-segredo-longo-devel
# Duração dos tokens (ms ou formato `ms` do pacote: 15m, 7d)
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
# Nome do cookie do refresh token
REFRESH_COOKIE_NAME=arena_rt
# Chave para cifrar as chaves de IA dos usuários (AES-256: 32 bytes em hex = 64 chars)
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=troque-por-uma-chave-hex-de-64-caracteres-0000000000000000000000000000
# Custo do bcrypt (10-12 é o recomendado; 12 é mais seguro e mais lento)
BCRYPT_ROUNDS=12
# Domínio do cookie (deixe vazio para o host atual)
COOKIE_DOMAIN=

# ------------------------------------------------------------ RATE LIMITING --
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=600
# Tentativas de login por IP antes do bloqueio temporário
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LOCK_MINUTES=15

# -------------------------------------------------------------------- CORS ---
# Origens permitidas, separadas por vírgula. Ex.: https://app.arenaestudos.com
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -------------------------------------------------------------------- LOGS ---
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# ------------------------------------------------------- RECUPERACAO SENHA ---
# Deixe SMTP_HOST vazio em desenvolvimento: o link é impresso no log do servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Arena Estudos <no-reply@arenaestudos.local>"
# Validade do token de redefinição de senha (minutos)
PASSWORD_RESET_TTL_MINUTES=60
# Troque por falso para não vazar o link em logs (produção)
PASSWORD_RESET_LOG_LINK=true

# ---------------------------------------------------------------- IA (opcional)
# Chaves do servidor (fallback gratuito quando o usuário não cadastrou a própria).
# Deixe vazio: o app continua funcionando com as chaves de cada usuário.
# NENHUMA dessas chaves chega ao frontend.
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
HF_TOKEN=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
XAI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1/chat/completions
# Provedor padrão quando o usuário não escolheu um
AI_DEFAULT_PROVIDER=groq
AI_DEFAULT_MODEL=llama-3.3-70b-versatile
AI_MAX_TOKENS=1500
AI_TEMPERATURE=0.6
AI_REQUEST_TIMEOUT_MS=60000
# Teto de tempo para a CADEIA INTEIRA de provedores (todas as tentativas somadas).
# 0 = usa o AI_REQUEST_TIMEOUT_MS. Na Vercel (Hobby) a função morre em 60s:
# deixe este orçamento uns 15s abaixo do limite da função.
AI_TOTAL_BUDGET_MS=0

# --------------------------------------------------------------- USUARIO ----
# E-mail/senha do primeiro ADMIN criado pelo seed (altere depois do primeiro login)
SEED_ADMIN_EMAIL=admin@arenaestudos.local
SEED_ADMIN_PASSWORD=Admin@123456
SEED_ADMIN_NAME=Administrador

# ==============================================================================
#  VERCEL (deploy em produção)
#  Guia completo: docs/DEPLOY-VERCEL.md
# ==============================================================================
# As variáveis abaixo devem ser cadastradas no painel da Vercel
# (Project -> Settings -> Environment Variables), e nao neste arquivo.
# Estao aqui apenas como referencia do que preencher.
#
#   NODE_ENV=production
#   # Conexao usada pela API (pooler ou direta, porta 5432)
#   DATABASE_URL="postgresql://postgres.<ref>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:5432/postgres?sslmode=require"
#
#   Se usar o pooler de transacao (6543) na API, rode as migracoes com a URL
#   direta (5432) apenas naquele comando - nao existe DIRECT_URL no schema:
#   $env:DATABASE_URL="postgresql://postgres.<ref>:<SENHA>@db.<ref>.supabase.co:5432/postgres?sslmode=require"
#   npx prisma migrate deploy
#   # Segredos novos e diferentes (min. 32 chars cada); troca-los desloga todos
#   JWT_ACCESS_SECRET=
#   JWT_REFRESH_SECRET=
#   # 64 caracteres hexadecimais
#   ENCRYPTION_KEY=
#   # URL publica (links de e-mail de recuperacao)
#   APP_WEB_URL=https://SEU-PROJETO.vercel.app
#   # Orcamento da cadeia de IA dentro dos 60s da funcao (plano Hobby)
#   AI_TOTAL_BUDGET_MS=45000
#   AI_REQUEST_TIMEOUT_MS=40000
#
#   # DEIXE EM BRANCO na Vercel:
#   CORS_ORIGINS=    # front e API no mesmo dominio -> nao ha CORS
#   COOKIE_DOMAIN=   # so com dominio proprio; no *.vercel.app nao define cookie
#
#   # Nao existe nenhuma variavel VITE_*: o frontend chama "/api" relativo.
#
# Migracoes (rode da sua maquina, antes do primeiro deploy):
#   npx prisma migrate deploy     # NUNCA "migrate dev" no Supabase (sem shadow DB)
#   npm run db:seed
