{
  "name": "@arena/backend",
  "version": "1.0.0",
  "private": true,
  "description": "API REST do Arena Estudos ALEPA — arquitetura modular por domínio",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "db:generate": "cd .. && prisma generate --schema prisma/schema.prisma",
    "db:migrate": "cd .. && prisma migrate dev --schema prisma/schema.prisma",
    "db:migrate:deploy": "cd .. && prisma migrate deploy --schema prisma/schema.prisma",
    "db:push": "cd .. && prisma db push --schema prisma/schema.prisma",
    "db:reset": "cd .. && prisma migrate reset --force --schema prisma/schema.prisma",
    "db:seed": "cd .. && node prisma/seed/index.js",
    "db:seed:questions": "cd .. && node scripts/import-legacy-questions.mjs",
    "db:setup": "cd .. && npm run db:setup",
    "db:status": "cd .. && prisma migrate status --schema prisma/schema.prisma",
    "db:studio": "cd .. && prisma studio --schema prisma/schema.prisma",
    "dev": "node --watch src/server.js",
    "diagnose:ai": "cd .. && node scripts/diagnose-ai.mjs",
    "import:questions": "cd .. && node scripts/import-legacy-questions.mjs",
    "legacy:import": "cd .. && node scripts/import-legacy-questions.mjs",
    "legacy:import-progress": "cd .. && node scripts/import-local-progress.mjs",
    "lint": "eslint src --ext .js",
    "notify:reviews": "cd .. && node scripts/send-review-reminders.mjs",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "ms": "^2.1.3",
    "nodemailer": "^6.9.16",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "pino-pretty": "^13.1.3",
    "supertest": "^7.0.0",
    "vitest": "^2.1.8"
  }
}
